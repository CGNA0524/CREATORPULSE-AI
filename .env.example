# ==========================================
# CREATORPULSE AI - ROOT CONFIGURATION
# ==========================================

# Database URL (SQLite default for zero-setup local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./creatorpulse.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://creatorpulse_user:creatorpulse_password@localhost:5432/creatorpulse_db

# Security & Tokens
SECRET_KEY=dev_super_secret_jwt_key_change_in_production_please
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AI / LLM Integration
ENABLE_EXTERNAL_LLM=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
