# Server Configuration
PROJECT_NAME="CreatorPulse AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="dev_super_secret_jwt_key_change_in_production_please"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback for instant zero-dependency development
DATABASE_URL="sqlite:///./creatorpulse.db"
# PostgreSQL Production example:
# DATABASE_URL="postgresql://creatorpulse_user:password@localhost:5432/creatorpulse_db"

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI / LLM Configuration (Optional, deterministic fallback is fully functional without API key)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
ENABLE_EXTERNAL_LLM=false

# Default Business Parameters
DEFAULT_CURRENCY="INR"
DEFAULT_GROSS_MARGIN_PCT=40.0
